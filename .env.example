# Postgres. Neon free tier works. Leave empty to run in memory.
DATABASE_URL=

# Shared secret. Must match the Authorization header configured on every
# Sarvam tool ("Bearer <secret>"). Generate with: openssl rand -hex 32
SARVAM_TOOL_SECRET=

# Salt for hashing caller phone numbers before storage. PII never sits in the DB.
CALLER_HASH_SALT=

# Optional. If set, the call webhook must carry ?token=... or x-webhook-token.
WEBHOOK_TOKEN=

# In production a missing SARVAM_TOOL_SECRET makes the API refuse tool calls.
NODE_ENV=development

PORT=3000
